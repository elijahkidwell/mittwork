# Copy to .env locally. Never commit real keys.

# Stripe (restricted secret + publishable, same mode: live or test)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (booking emails)
RESEND_API_KEY=

# Auth + database (set on deploy; preview can use PGLite)
VITE_AUTH_ENABLED=true
BETTER_AUTH_URL=https://mitt-work.online
DATABASE_URL=

# Optional
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
